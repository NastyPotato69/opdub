# Media files — never commit
*.mp4
*.mkv
*.avi
*.mov
*.wav
*.aac
*.mp3
*.flac

# Generated outputs. The folder itself is tracked so a fresh clone has it
# already: docker-compose bind-mounts ./out, and if it does not exist the
# daemon creates it root-owned, which you then cannot clean up without sudo.
out/*
!out/.gitkeep

# fixtures/ is deliberately NOT ignored. The files are synthetic — generated
# from a seed by make_fixtures.py — and tracking them is what lets a fresh
# clone run the tests and the scorer without generating anything first. This
# used to say `fixtures/`, which was misleading: the files were already
# tracked, so the rule did nothing except silently hide any new one.

# Local media directories (mount points — not committed)
edits/
sources/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Local project notes and diagnostics
CLAUDE.md
diagnose_mismatch.py
probe_workspace.py
session*.txt
*.log
metrics.json

# Editor / OS
.DS_Store
.venv/
venv/
.env

# Install manifest (written by install.sh, read by uninstall.sh)
.opdub-install.manifest

# Compose volumes. The folders are tracked so a fresh clone has somewhere to
# put media; their contents never are.
input/**
!input/**/
!input/**/.gitkeep
.env

# UI test harness dependencies
tests/ui/node_modules/
tests/ui/package-lock.json
